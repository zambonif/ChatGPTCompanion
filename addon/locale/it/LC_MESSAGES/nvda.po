msgid "Accessible text unavailable. Try browse mode or another supported browser."
msgstr "Testo accessibile non disponibile. Prova la modalità navigazione o un altro browser compatibile."

msgid "Answer reading mode"
msgstr "Modalità di lettura delle risposte"

msgid "Automatic reading disabled."
msgstr "Lettura automatica disattivata."

msgid "Automatic reading enabled."
msgstr "Lettura automatica attivata."

msgid "Automatic reading is disabled."
msgstr "La lettura automatica è disattivata."

msgid "ChatGPT Companion"
msgstr "ChatGPT Companion"

msgid "ChatGPT: {text}"
msgstr "ChatGPT: {text}"

msgid "Complete answer"
msgstr "Risposta completa"

msgid "Confirm sending when reading sent messages is disabled"
msgstr "Conferma l’invio quando la lettura dei messaggi inviati è disattivata"

msgid "Conversation too long. Open a shorter conversation for automatic reading."
msgstr "Conversazione troppo lunga. Apri una conversazione più breve per la lettura automatica."

msgid "Enable automatic reading"
msgstr "Attiva la lettura automatica"

msgid "Fallback after silence (seconds; 0 disables)"
msgstr "Alternativa dopo il silenzio (secondi; 0 disattiva)"

msgid "Ignore interface notices and footer text"
msgstr "Ignora avvisi e testi dell’interfaccia"

msgid "Message sent."
msgstr "Messaggio inviato."

msgid "Messages: {count}. Generation control: {state}."
msgstr "Messaggi: {count}. Controllo della generazione: {state}."

msgid "New paragraphs (experimental)"
msgstr "Nuovi paragrafi (sperimentale)"

msgid "No answer available."
msgstr "Nessuna risposta disponibile."

msgid "No progress update available."
msgstr "Nessun aggiornamento sullo stato disponibile."

msgid "No supported conversation detected."
msgstr "Nessuna conversazione compatibile rilevata."

msgid "Only the active ChatGPT conversation is monitored. The silence fallback can mistake a pause for completion."
