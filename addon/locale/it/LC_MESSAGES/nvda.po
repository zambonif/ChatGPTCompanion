msgid "Progress: {text}"
msgstr "Stato: {text}"

msgid "Read answers"
msgstr "Leggi le risposte"

msgid "Read progress updates"
msgstr "Leggi gli aggiornamenti sullo stato"

msgid "Read sent messages"
msgstr "Leggi i messaggi inviati"

msgid "Read the latest available ChatGPT answer"
msgstr "Leggi l’ultima risposta disponibile di ChatGPT"

msgid "Read the latest progress update"
msgstr "Leggi l’ultimo aggiornamento sullo stato"

msgid "Report ChatGPT accessibility diagnostics"
msgstr "Annuncia la diagnostica di accessibilità di ChatGPT"

msgid "Toggle automatic ChatGPT reading"
msgstr "Attiva o disattiva la lettura automatica di ChatGPT"

msgid "Wait after completion (seconds)"
msgstr "Attesa dopo il completamento (secondi)"

msgid "You said: {text}"
msgstr "Hai detto: {text}"

msgid "busy"
msgstr "in corso"

msgid "idle"
msgstr "inattivo"

